{
  "name": "@cwolf-systems/playwright-perceptual",
  "version": "0.1.0",
  "description": "Perceptual screenshot and pixel assertions for Playwright, judged by CIEDE2000 colour difference.",
  "private": true,
  "license": "Apache-2.0",
  "author": "CWOLFSYSTEMS <info@cwolfsystems.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwolf-systems/playwright-perceptual.git"
  },
  "homepage": "https://github.com/cwolf-systems/playwright-perceptual#readme",
  "bugs": "https://github.com/cwolf-systems/playwright-perceptual/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "playwright test",
    "test:runner": "vitest run --project runner",
    "test:count": "node tools/test-count.mjs",
    "bench": "npm run build && node bench/speed.mjs",
    "bench:accuracy": "npm run build && node bench/accuracy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.53"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.10.0",
    "looks-same": "^10.0.1",
    "pixelmatch": "^7.2.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "playwright",
    "visual-regression",
    "screenshot",
    "ciede2000",
    "color-difference",
    "testing"
  ]
}
